{
  "name": "robamimi-dakoku",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "check": "tsc -b",
    "test": "vitest run",
    "test:rules": "JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 PATH=/usr/lib/jvm/java-21-openjdk-amd64/bin:$PATH firebase emulators:exec --only firestore --project demo-robamimi-dakoku \"vitest run src/firebase/firestore.rules.test.ts\"",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "12.17.0",
    "idb": "8.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase-tools": "15.24.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
